<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Necessaria para o botao "Buscar atualizacoes" entregar o APK baixado ao
        instalador do sistema. Nao e permissao de runtime: nao passa por
        requestPermissions, e sim por uma tela de Configuracoes
        (Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES), e o app checa
        canRequestPackageInstalls() antes de tentar.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.HardwareScrapper">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            FileProvider: a unica forma de entregar a outro app um arquivo que
            vive no cacheDir/filesDir privado. Um Uri file:// direto lanca
            FileUriExposedException desde a API 24 (que e o nosso minSdk); o
            caminho certo e um content:// com permissao temporaria.

            exported="false" + grantUriPermissions="true": nenhum app pode
            consultar o provider por conta propria, o acesso vem SO do
            FLAG_GRANT_READ_URI_PERMISSION que o proprio Intent carrega, e morre
            quando o destino termina.

            ${applicationId} e substituido pelo AGP, entao a authority acompanha
            qualquer suffix de build type sem duplicar a string. O Kotlin monta
            "$packageName.fileprovider", que resolve para o mesmo valor.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
