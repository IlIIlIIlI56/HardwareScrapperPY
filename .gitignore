__pycache__/
*.py[cod]

# Pasta de dados do usuario: produtos coletados, benchmarks curados,
# exportacoes e o perfil da janela. E criada ao lado do executavel na primeira
# abertura e semeada a partir de data/ -- e o conteudo dela e de quem usa o
# app, nao do repositorio.
dados/

# backup automatico do reextract_specs.py
data/products.json.bak
dados/products.json.bak

# artefatos do empacotamento (build.ps1 refaz os tres do zero)
build/
dist/
.venv-build/

# artefatos do projeto Android (Android Studio/Gradle refazem do zero)
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/local.properties
android/app/.cxx/

# metadados de IDE (IntelliJ/Android Studio/PyCharm) -- so aparecem se alguem
# abrir a raiz do repo como projeto em vez de so android/; regeneraveis, e
# especificos de cada maquina (caminhos de SDK, cache de dispositivos, etc.)
.idea/
*.iml
